{% extends 'base.html.twig' %}

{% block title %}Se connecter
{% endblock %}

{% block body %}
	<div class="bg-gradient-to-br from-blue-100 via-blue-50 to-indigo-100 min-h-screen flex items-center justify-center p-4">
		<div
			class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden transform transition-all hover:scale-[1.01] duration-300">
			<!-- Header Section -->
			<div class="px-8 pt-10 pb-6 text-center">
				<div
					class="mx-auto bg-blue-100 w-16 h-16 rounded-full flex items-center justify-center mb-4">
					<!-- Icone User -->
					<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-blue-600" fill="none" viewbox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
					</svg>
				</div>
				<h1 class="text-3xl font-bold text-gray-800">Bienvenue</h1>
				<p class="text-gray-500 mt-2">Connectez-vous à votre espace</p>
			</div>

			{% if error %}
				<div class="px-8 pb-4">
					<div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
						<span class="block sm:inline">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
					</div>
				</div>
			{% endif %}

			<!-- Form Section -->
			<div class="px-8 pb-10">
				<form
					method="post" action="{{ path('app_login') }}">

					<!-- Email Input -->
					<div class="mb-6">
						<label for="username" class="block text-sm font-semibold text-gray-700 mb-2">Email</label>
						<div class="relative">
							<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
								<svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
								</svg>
							</div>
							<input type="email" id="username" name="_username" value="{{ last_username }}" class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200 shadow-sm text-gray-900 placeholder-gray-400 sm:text-sm" placeholder="exemple@email.com" required autofocus>
						</div>
					</div>

					<!-- Password Input -->
					<div class="mb-6">
						<div class="flex justify-between items-center mb-2">
							<label for="password" class="block text-sm font-semibold text-gray-700">Mot de passe</label>
						</div>
						<div class="relative">
							<div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
								<svg class="h-5 w-5 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24" stroke="currentColor">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
								</svg>
							</div>
							<input type="password" id="password" name="_password" class="block w-full pl-10 pr-3 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200 shadow-sm text-gray-900 placeholder-gray-400 sm:text-sm" placeholder="••••••••" required>
						</div>
					</div>

					<!-- Remember Me & Forgot Link -->
					<div class="flex items-center justify-between mb-6">
						<label class="flex items-center cursor-pointer">
							<input type="checkbox" name="_remember_me" class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded cursor-pointer">
							<span class="ml-2 text-sm text-gray-600 select-none">Se souvenir de moi</span>
						</label>
					</div>

					<input
					type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

					<!-- Submit Button -->
					<button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-md text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-200">
						Connexion
					</button>
				</form>

				<!-- Footer / Register Link -->
				<div class="mt-8 text-center border-t border-gray-100 pt-6">
					<p class="text-sm text-gray-600">
						Vous n'avez pas de compte ?
						<a href={{ path('app_register') }} class="font-medium text-blue-600 hover:text-blue-500 hover:underline transition duration-150">
							Inscrivez-vous !
						</a>
					</p>
					<!-- Note: Replace href="#" with {{ path('app_register') }} in your Symfony project -->
				</div>
			</div>
		</div>
	</div>
{% endblock %}
