{% extends 'base.html.twig' %}

{% block title %}Spots de Pêche
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
	<style>
		* {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}
		body {
			font-family: 'Segoe UI', sans-serif;
		}

		.app-layout {
			display: flex;
			flex-direction: column;
			height: 100vh;
			overflow: hidden;
		}

		/* Navbar */
		.navbar {
			display: flex;
			align-items: center;
			justify-content: space-between;
			padding: 0 1.5rem;
			height: 56px;
			border-bottom: 1px solid #e5e7eb;
			background: white;
			flex-shrink: 0;
		}
		.navbar-brand {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			font-weight: 700;
			font-size: 1.1rem;
			color: #1d4ed8;
		}
		.navbar-nav {
			display: flex;
			align-items: center;
			gap: 1.5rem;
		}
		.navbar-nav a {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			font-size: 0.9rem;
			color: #6b7280;
			text-decoration: none;
			padding: 0.3rem 0.75rem;
			border-radius: 9999px;
			transition: background 0.15s;
		}
		.navbar-nav a:hover {
			background: #f3f4f6;
			color: #1d4ed8;
		}
		.navbar-nav a.active {
			background: #eff6ff;
			color: #1d4ed8;
			font-weight: 600;
		}

		/* Main content */
		.main-content {
			display: flex;
			flex: 1;
			overflow: hidden;
		}

		/* Map */
		#map {
			width: 50%;
			height: 100%;
		}

		/* Panel droit */
		.info-panel {
			width: 50%;
			height: 100%;
			overflow-y: auto;
			border-left: 1px solid #e5e7eb;
			background: #f9fafb;
			display: flex;
			flex-direction: column;
		}

		/* État vide */
		.empty-state {
			flex: 1;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			gap: 1rem;
			color: #9ca3af;
		}
		.empty-state svg {
			width: 48px;
			height: 48px;
		}
		.empty-state p {
			font-size: 0.95rem;
		}

		/* Détail d'un spot */
		.spot-detail {
			display: none;
			padding: 1.5rem;
			flex-direction: column;
			gap: 1rem;
		}
		.spot-detail.visible {
			display: flex;
		}

		.spot-detail h2 {
			font-size: 1.3rem;
			font-weight: 700;
			color: #111827;
		}
		.spot-detail .coords {
			font-size: 0.8rem;
			color: #6b7280;
		}
		.spot-detail .description {
			background: white;
			border: 1px solid #e5e7eb;
			border-radius: 8px;
			padding: 1rem;
			font-size: 0.9rem;
			color: #374151;
			min-height: 80px;
		}
		.spot-detail .no-description {
			color: #9ca3af;
			font-style: italic;
		}

		.btn-delete {
			align-self: flex-start;
			background: #fee2e2;
			color: #dc2626;
			border: none;
			border-radius: 6px;
			padding: 0.4rem 1rem;
			font-size: 0.85rem;
			cursor: pointer;
			font-weight: 600;
		}
		.btn-delete:hover {
			background: #fecaca;
		}

		/* Formulaire d'ajout */
		.add-form {
			padding: 1rem 1.5rem;
			border-top: 1px solid #e5e7eb;
			background: white;
			display: flex;
			gap: 0.5rem;
			align-items: center;
			flex-shrink: 0;
		}
		.add-form input[type="text"] {
			flex: 1;
			border: 1px solid #d1d5db;
			border-radius: 6px;
			padding: 0.45rem 0.75rem;
			font-size: 0.85rem;
		}
		.add-form input[type="text"]:focus {
			outline: none;
			border-color: #3b82f6;
		}
		.add-form button {
			background: #3b82f6;
			color: white;
			border: none;
			border-radius: 6px;
			padding: 0.45rem 1rem;
			font-size: 0.85rem;
			font-weight: 600;
			cursor: pointer;
			white-space: nowrap;
		}
		.add-form button:hover {
			background: #2563eb;
		}
		.add-hint {
			font-size: 0.8rem;
			color: #6b7280;
			white-space: nowrap;
		}
	</style>
{% endblock %}

{% block body %}
	<div
		class="app-layout">

		{# Navbar #}
		<nav class="navbar">
			<div class="navbar-brand">
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewbox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
				Spots de Pêche
			</div>
			<div class="navbar-nav">
				<a href="#" class="active">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewbox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
					Carte
				</a>
				<a href="#">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewbox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
					Recherche
				</a>
				<a href="{{ path('app_logout') }}">
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewbox="0 0 24 24"><path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/></svg>
					Profil
				</a>
			</div>
		</nav>

		{# Contenu principal #}
		<div
			class="main-content">

			{# Carte Leaflet #}
			<div id="map"></div>

			{# Panel d'informations #}
			<div
				class="info-panel">

				{# État vide #}
				<div class="empty-state" id="empty-state">
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#d1d5db" stroke-width="1.5" viewbox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
						<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>
					</svg>
					<p>Sélectionnez un spot sur la carte</p>
				</div>

				{# Détail du spot sélectionné #}
				<div class="spot-detail" id="spot-detail">
					<h2 id="spot-label"></h2>
					<div class="coords" id="spot-coords"></div>
					<div class="description" id="spot-description"></div>
					<button class="btn-delete" id="btn-delete">🗑️ Supprimer ce spot</button>
				</div>

				{# Formulaire d'ajout en bas #}
				<div class="add-form">
					<input type="text" id="label-input" placeholder="Nom du spot..."/>
					<button onclick="enableAddMode()">📍 Ajouter</button>
					<span class="add-hint" id="add-hint" style="display:none">Cliquez sur la carte</span>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
const map = L.map('map').setView([
46.6034, 1.8883
], 6); // France entière

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {attribution: '© OpenStreetMap contributors'}).addTo(map);

let addMode = false;
const markers = {};
let selectedId = null;

async function loadPoints() {
const res = await fetch('/api/map/points');
const points = await res.json();
points.forEach(addMarkerToMap);
}

function addMarkerToMap(point) {
const marker = L.marker([point.latitude, point.longitude]).addTo(map).on('click', () => showSpotDetail(point));
markers[point.id] = {
marker,
point
};
}

function showSpotDetail(point) {
selectedId = point.id;
document.getElementById('empty-state').style.display = 'none';
const detail = document.getElementById('spot-detail');
detail.classList.add('visible');
document.getElementById('spot-label').textContent = point.label;
document.getElementById('spot-coords').textContent = `📍 ${
point.latitude.toFixed(5)
}, ${
point.longitude.toFixed(5)
}`;
const desc = document.getElementById('spot-description');
if (point.description) {
desc.textContent = point.description;
desc.classList.remove('no-description');
} else {
desc.textContent = 'Aucune description pour ce spot.';
desc.classList.add('no-description');
}
}

window.enableAddMode = function () {
const label = document.getElementById('label-input').value.trim();
if (! label) {
alert('Veuillez entrer un nom pour le spot.');
return;
}
addMode = true;
document.getElementById('add-hint').style.display = 'inline';
};

map.on('click', async function (e) {
if (! addMode) 
return;

const label = document.getElementById('label-input').value.trim();
const {lat, lng} = e.latlng;

const res = await fetch('/api/map/points', {
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify(
{latitude: lat, longitude: lng, label, description: null}
)
});

if (res.ok) {
const data = await res.json();
const point = {
id: data.id,
latitude: lat,
longitude: lng,
label,
description: null
};
addMarkerToMap(point);
showSpotDetail(point);
document.getElementById('label-input').value = '';
document.getElementById('add-hint').style.display = 'none';
addMode = false;
}
});

document.getElementById('btn-delete').addEventListener('click', async function () {
if (! selectedId) 
return;

const res = await fetch (`/api/map/points/${selectedId}`, {method: 'DELETE'});
if (res.ok) {
map.removeLayer(markers[selectedId].marker);
delete markers[selectedId];
selectedId = null;
document.getElementById('spot-detail').classList.remove('visible');
document.getElementById('empty-state').style.display = 'flex';
}
});

loadPoints();
});
	</script>
{% endblock %}
